{
  "name": "btd",
  "version": "1.4.5",
  "description": "A browser-based tower-defense project with custom development tools and editors.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "gen:manifest": "node tools/gen-manifest.mjs",
    "gen:thumbs": "node tools/gen-map-thumbs.mjs",
    "check:syntax": "node tools/check-syntax.mjs",
    "typecheck:core": "npx --yes --package typescript@7.0.2 tsc --noEmit -p jsconfig.typecheck.json",
    "audit:deps": "node tools/audit-dependencies.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Konoshimaru/bloons-5.5.git"
  },
  "keywords": [
    "tower-defense",
    "browser-game",
    "pixi.js",
    "vite",
    "game-development"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Konoshimaru/bloons-5.5/issues"
  },
  "homepage": "https://github.com/Konoshimaru/bloons-5.5#readme",
  "devDependencies": {
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "vite": "^8.1.7",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  },
  "private": true
}
